# Copy to .env and adjust if needed.

# App connects to Postgres as the READ-ONLY user (safety guardrail).
DATABASE_URL=postgresql://readonly_app:readonly@localhost:5433/company

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# How many times the self-correcting loop may retry on a SQL error.
MAX_SQL_RETRIES=3

# Hard cap on rows returned (safety + keeps responses small).
MAX_ROWS=200
